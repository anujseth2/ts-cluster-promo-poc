# ── SOURCE cluster ──────────────────────────────────────────────────────────
# The cluster you promote FROM (e.g. dev/staging cluster).
TS_SOURCE_HOST=https://source-cluster.thoughtspot.cloud
# Auth: use EITHER a bearer token, OR username+password. Token wins if both set.
TS_SOURCE_TOKEN=
TS_SOURCE_USERNAME=
TS_SOURCE_PASSWORD=
# Optional org on the source cluster (leave blank for the default/primary org).
TS_SOURCE_ORG=

# ── TARGET cluster ──────────────────────────────────────────────────────────
# The cluster you promote TO (e.g. prod cluster). A DIFFERENT host + creds.
TS_TARGET_HOST=https://target-cluster.thoughtspot.cloud
TS_TARGET_TOKEN=
TS_TARGET_USERNAME=
TS_TARGET_PASSWORD=
TS_TARGET_ORG=

# ── GitHub (the bridge / source of truth) ───────────────────────────────────
GITHUB_TOKEN=your_github_pat
GITHUB_REPO=anujseth2/ts-cluster-promo

# ── Proxy (optional) ────────────────────────────────────────────────────────
# Corporate proxy for every outbound call (ThoughtSpot and Databricks), e.g. http://proxy:8080.
TS_PROXY=

# ── Databricks, read directly (optional, recommended for hive_metastore) ────
# The tool reads column names, casing and types straight from each warehouse with these, because
# ThoughtSpot's own column read times out on hive_metastore. HOST is the workspace URL, e.g.
# https://dbc-1234abcd-5678.cloud.databricks.com, WAREHOUSE is the SQL warehouse ID (not its URL),
# TOKEN is a personal access token.
#
# SOURCE: the warehouse behind the source cluster's connection. Checked first, on Source Audit.
# Left blank, the source check reads with the TARGET values below.
TS_SOURCE_DBX_HOST=
TS_SOURCE_DBX_WAREHOUSE=
TS_SOURCE_DBX_TOKEN=
# TARGET: the warehouse behind the target cluster's connection. Checked second, on TML Validation.
TS_TARGET_DBX_HOST=
TS_TARGET_DBX_WAREHOUSE=
TS_TARGET_DBX_TOKEN=
